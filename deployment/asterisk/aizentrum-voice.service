[Unit]
Description=AiZentrum voice assistant
After=network-online.target asterisk.service
Wants=network-online.target

[Service]
Type=simple
User=aizentrum-voice
Group=aizentrum-voice
WorkingDirectory=/opt/aizentrum-voice
EnvironmentFile=/etc/aizentrum-voice/voice.env
ExecStart=/usr/local/bin/node /opt/aizentrum-voice/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
